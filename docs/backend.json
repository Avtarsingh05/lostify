
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Lostify application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["USER", "GUARD", "ADMIN"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "email", "createdAt"]
    },
    "ClockRoomItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ClockRoomItem",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "itemType": { "type": "string" },
        "color": { "type": "string" },
        "description": { "type": "string" },
        "rackNumber": { "type": "string" },
        "slotNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["stored", "collected"] },
        "otp": { "type": "string" },
        "expectedReturnDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "collectedAt": { "type": "string", "format": "date-time" },
        "guardId": { "type": "string" }
      },
      "required": ["id", "userId", "imageUrl", "itemType", "status", "rackNumber", "slotNumber", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/User",
      "description": "Stores user profiles."
    },
    "/clockRoomItems/{itemId}": {
      "schema": "#/backend/entities/ClockRoomItem",
      "description": "Luggage stored in the university clock room."
    }
  }
}
