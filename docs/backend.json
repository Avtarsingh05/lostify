
{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles and roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "GUARD", "USER"] },
        "registrationNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email"]
    },
    "Item": {
      "title": "Item",
      "description": "Lost or found items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "locationDescription": { "type": "string" },
        "type": { "type": "string", "enum": ["lost", "found"] },
        "status": { "type": "string" },
        "imageUrl": { "type": "string" },
        "reportedAt": { "type": "string", "format": "date-time" },
        "storageOffice": { "type": "string" },
        "verifiedBy": { "type": "string" },
        "claimerRegNo": { "type": "string" },
        "resolvedBy": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "System broadcasts and user alerts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Banner": {
      "title": "Banner",
      "description": "Dashboard promotional banners.",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ShopItem": {
      "title": "ShopItem",
      "description": "Items available in the campus shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Shop purchase records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemImageUrl": { "type": "string" },
        "amount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "deliveryEmail": { "type": "string" },
        "deliveryPhone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ClockRoomItem": {
      "title": "ClockRoomItem",
      "description": "Luggage storage records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "itemType": { "type": "string" },
        "color": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "rackNumber": { "type": "string" },
        "slotNumber": { "type": "string" },
        "status": { "type": "string" },
        "otp": { "type": "string" },
        "expectedReturnDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "collectedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ClockRoomHandover": {
      "title": "ClockRoomHandover",
      "description": "Clock Room pickup verification data.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "userId": { "type": "string" },
        "guardId": { "type": "string" },
        "guardName": { "type": "string" },
        "verificationCode": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Handover": {
      "title": "Handover",
      "description": "General item handover session data.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "itemImageUrl": { "type": "string" },
        "guardId": { "type": "string" },
        "guardName": { "type": "string" },
        "verificationCode": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": { "providers": ["password", "anonymous"] },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "schema": { "$ref": "#/backend/entities/User" }, "description": "Stores user profiles." } },
      { "path": "/items/{itemId}", "definition": { "entityName": "Item", "schema": { "$ref": "#/backend/entities/Item" }, "description": "Stores lost and found items." } },
      { "path": "/notifications/{notifId}", "definition": { "entityName": "Notification", "schema": { "$ref": "#/backend/entities/Notification" }, "description": "Stores system notifications." } },
      { "path": "/banners/{bannerId}", "definition": { "entityName": "Banner", "schema": { "$ref": "#/backend/entities/Banner" }, "description": "Stores dashboard banners." } },
      { "path": "/shopItems/{itemId}", "definition": { "entityName": "ShopItem", "schema": { "$ref": "#/backend/entities/ShopItem" }, "description": "Stores shop items." } },
      { "path": "/orders/{orderId}", "definition": { "entityName": "Order", "schema": { "$ref": "#/backend/entities/Order" }, "description": "Stores shop orders." } },
      { "path": "/clockRoomItems/{itemId}", "definition": { "entityName": "ClockRoomItem", "schema": { "$ref": "#/backend/entities/ClockRoomItem" }, "description": "Stores clock room storage records." } },
      { "path": "/clockRoomHandovers/{handoverId}", "definition": { "entityName": "ClockRoomHandover", "schema": { "$ref": "#/backend/entities/ClockRoomHandover" }, "description": "Stores clock room pickup sessions." } },
      { "path": "/handovers/{handoverId}", "definition": { "entityName": "Handover", "schema": { "$ref": "#/backend/entities/Handover" }, "description": "Stores general item handover sessions." } },
      { "path": "/system/config", "definition": { "entityName": "Config", "schema": { "type": "object", "properties": { "appLogo": { "type": "string" } } }, "description": "Stores system configuration." } }
    ]
  }
}
