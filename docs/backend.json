
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Lostify application.",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "email", "createdAt"]
    },
    "Item": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "locationDescription": { "type": "string" },
        "eventDate": { "type": "string", "format": "date-time" },
        "storageInfo": { "type": "string" },
        "reportedAt": { "type": "string", "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "imageUrl", "category", "type", "status", "reportedAt"]
    },
    "Chat": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastMessageAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "itemId", "participantIds", "createdAt"]
    },
    "Message": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "chatId", "senderId", "content", "sentAt"]
    },
    "Auction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Auction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "sellerId": { "type": "string" },
        "startPrice": { "type": "number" },
        "currentBid": { "type": "number" },
        "highestBidderId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "itemId", "sellerId", "startPrice", "currentBid", "startTime", "endTime", "status", "createdAt"]
    },
    "Bid": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bid",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "auctionId": { "type": "string" },
        "bidderId": { "type": "string" },
        "amount": { "type": "number" },
        "bidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "auctionId", "bidderId", "amount", "bidAt"]
    },
    "AdminActivityLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminActivityLog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminUserId": { "type": "string" },
        "action": { "type": "string" },
        "targetEntity": { "type": "string" },
        "targetEntityId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" }
      },
      "required": ["id", "adminUserId", "action", "targetEntity", "targetEntityId", "timestamp"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/backend/entities/User" }, "description": "Stores user profiles." }
      },
      {
        "path": "/roles_admin/{adminId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/backend/entities/User" }, "description": "Admin roles." }
      },
      {
        "path": "/items/{itemId}",
        "definition": { "entityName": "Item", "schema": { "$ref": "#/backend/entities/Item" }, "description": "Reported items." }
      },
      {
        "path": "/chats/{chatId}",
        "definition": { "entityName": "Chat", "schema": { "$ref": "#/backend/entities/Chat" }, "description": "Private conversations." }
      },
      {
        "path": "/chats/{chatId}/messages/{messageId}",
        "definition": { "entityName": "Message", "schema": { "$ref": "#/backend/entities/Message" }, "description": "Chat messages." }
      },
      {
        "path": "/auctions/{auctionId}",
        "definition": { "entityName": "Auction", "schema": { "$ref": "#/backend/entities/Auction" }, "description": "Auction listings." }
      },
      {
        "path": "/auctions/{auctionId}/bids/{bidId}",
        "definition": { "entityName": "Bid", "schema": { "$ref": "#/backend/entities/Bid" }, "description": "Individual bids." }
      },
      {
        "path": "/adminActivityLogs/{logId}",
        "definition": { "entityName": "AdminActivityLog", "schema": { "$ref": "#/backend/entities/AdminActivityLog" }, "description": "Admin activity logs." }
      }
    ]
  }
}
