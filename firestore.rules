
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE HELPERS
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * MASTER AUTHORITY BYPASS
     * Direct root access for super administrators.
     * Uses prioritized UID checks for speed and reliability.
     */
    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" ||
        request.auth.uid == "9Qv4QkTuukaYhr2sggnQmQmqgHu1" ||
        (request.auth.token.keys().contains('email') && (
          request.auth.token.email == "worker@gmail.com" ||
          request.auth.token.email == "forigloohelp@gmail.com" ||
          request.auth.token.email == "avtarsingh9528972330@gmail.com"
        ))
      );
    }

    /**
     * STAFF VERIFICATION
     * Checks if user has GUARD or ADMIN role.
     */
    function isStaff() {
      if (!isSignedIn()) return false;
      if (isMasterAdmin()) return true;
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDocPath) && (
        get(userDocPath).data.role == "GUARD" || 
        get(userDocPath).data.role == "ADMIN"
      );
    }

    /**
     * GLOBAL BYPASS
     * Ensures Master Admins are never blocked by any rules below.
     */
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isStaff());
    }

    match /items/{itemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isStaff() || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    match /clockRoomItems/{itemId} {
      // Staff can read all. Students only their own.
      allow get: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      // List queries must be filtered by userId for students. Staff can list all.
      allow list: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn();
      allow update: if isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isStaff();
    }

    match /clockRoomHandovers/{handoverId} {
      allow get: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isSignedIn();
      allow delete: if isStaff();
    }

    match /handovers/{handoverId} {
      allow get: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      allow update: if isSignedIn();
      allow delete: if isStaff();
    }

    match /system/config {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
