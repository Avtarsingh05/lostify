rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * LOSTIFY GLOBAL SECURITY RULES - COMPREHENSIVE FIX
     * WHITELISTED ADMIN: PX8zNjMWBWTFGYnaYWrtxojquD02
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" || 
        request.auth.token.email == "worker@gmail.com"
      );
    }

    // Check for Guard role or higher
    function isGuard() {
      return isSuperAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "GUARD");
    }

    // GLOBAL READ ACCESS: Allow all authenticated users to read any data
    // This prevents "list" permission errors across the app.
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Specific Write Permissions for standard users
    match /users/{userId} {
      allow write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /items/{itemId} {
      allow create: if isSignedIn();
      allow update: if isGuard() || isSuperAdmin() || (resource.data.ownerId == request.auth.uid);
      allow delete: if isSuperAdmin() || (resource.data.ownerId == request.auth.uid);
    }

    match /chats/{chatId} {
      allow write: if isSignedIn();
      match /messages/{messageId} {
        allow write: if isSignedIn();
      }
    }

    match /auctions/{auctionId} {
      allow write: if isSuperAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      match /bids/{bidId} {
        allow create: if isSignedIn();
      }
    }
  }
}