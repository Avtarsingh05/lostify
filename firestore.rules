
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Lostify Ultra-Resilient Rules
     * Allows all authenticated users access to core collections to prevent complex rule failures.
     */

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Guard/Admin handled by logic
    }

    match /banners/{bannerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /shopItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
