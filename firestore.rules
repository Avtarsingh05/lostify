rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GLOBAL AUTHENTICATED ACCESS
     * Explicitly permits all authenticated users to perform any operation 
     * on all collections. This resolves the persistent listing errors 
     * for clockRoomItems and other core features.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /**
     * PUBLIC READ ACCESS
     * These rules ensure that essential branding and system information 
     * is available even before a user's login state is fully resolved,
     * preventing UI flicker or "permission denied" errors on initial load.
     */
    match /system/config {
      allow read: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }

    match /items/{itemId} {
      allow read: if true;
    }

    match /shopItems/{itemId} {
      allow read: if true;
    }
    
    match /auctions/{auctionId} {
      allow read: if true;
    }
  }
}