rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /**
     * MASTER AUTHORITY RULE
     * Absolute unrestricted access for the Campus Owner and Super Admins.
     * This resolves all 'method: list' and permission blocks for the master accounts.
     */
    match /{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" ||
        request.auth.token.email == "worker@gmail.com" ||
        request.auth.token.email == "forigloohelp@gmail.com"
      );
    }

    // 2. USER PROFILES
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. CAMPUS ITEMS (Lost & Found)
    match /items/{itemId} {
      // Allow any signed-in student to browse and report
      allow read, create: if request.auth != null;
      // Allow owners to update their own reports
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      // Admins handle deletions (covered by Master Rule)
    }

    // 4. SHOP & ORDERS
    match /shopItems/{itemId} {
      allow read: if request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid);
    }

    // 5. SYSTEM NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
    }

    // 6. BANNERS & AUCTIONS
    match /banners/{bannerId} {
      allow read: if request.auth != null;
    }

    match /auctions/{auctionId} {
      allow read: if request.auth != null;
    }
  }
}