
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Publicly Accessible System Rules
     * Allows anyone to read config, notifications, and banners (including unauthenticated users).
     */
    match /system/config {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /**
     * Item & Shop Rules
     * Items are readable by everyone for gallery/search purposes.
     */
    match /items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /**
     * User Specific Data
     */
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /clockRoomItems/{itemId} {
      allow read, write: if request.auth != null;
    }
    
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    /**
     * Community Chat Rules
     */
    match /community_messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /**
     * Core Application Rules
     * Default fallback for all other collections.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
