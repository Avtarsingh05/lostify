
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * GLOBAL AUTHENTICATED ACCESS
     * Explicitly allows all authenticated users to read, list, and write across all collections.
     * This resolves persistent "Missing or insufficient permissions" errors for students.
     */
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    /**
     * PUBLIC READ ACCESS
     * Critical for branding and system configuration assets before login.
     */
    match /system/config {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }
  }
}
