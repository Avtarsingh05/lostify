
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * GLOBAL AUTHENTICATED ACCESS
     * Using a recursive wildcard to ensure all subcollections and list operations
     * are permitted for signed-in users. This fixes persistent "Missing or insufficient permissions" errors.
     */
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    /**
     * PUBLIC READ ACCESS
     * Critical for branding and system configuration assets before login.
     */
    match /system/config {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }
  }
}
