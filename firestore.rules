
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * LOSTIFY SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset enforces a strict identity-based access model while maintaining 
     * flexibility for data schema iteration. Access is primarily governed by 
     * ownership fields (ownerId, sellerId, senderId) and membership arrays (participantIds).
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Checks if the user is part of a participant list (used for Chats and Messages)
    function isParticipant(participants) {
      return isSignedIn() && (request.auth.uid in participants);
    }

    // Validates that a resource exists and is owned by the requester (for updates/deletes)
    function isExistingOwner(ownerId) {
      return resource != null && request.auth.uid == ownerId;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the User collection.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    /**
     * @description Look-up collection for administrative privileges.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false; 
    }

    /**
     * @description Items (Lost/Found).
     * We explicitly allow 'list' and 'get' to all signed-in users for recovery transparency.
     */
    match /items/{itemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    /**
     * @description Private chats between users.
     */
    match /chats/{chatId} {
      allow get: if isParticipant(resource.data.participantIds) || isAdmin();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isParticipant(resource.data.participantIds);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds) || isAdmin());
        allow create: if isSignedIn();
        allow update, delete: if resource != null && resource.data.senderId == request.auth.uid;
      }
    }

    /**
     * @description Public auction listings for items.
     */
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if (resource != null && resource.data.bidderId == request.auth.uid) || isAdmin();
      }
    }

    /**
     * @description Audit logs for admin actions.
     */
    match /adminActivityLogs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    /**
     * @description Application Settings.
     * Trigger deployment with comment to fix list permission.
     */
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
