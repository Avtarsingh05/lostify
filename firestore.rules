
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * GLOBAL AUTHENTICATED ACCESS
     * Explicitly permit all signed-in users to read and write to all collections.
     * This fixes the "Missing or insufficient permissions" error for list operations
     * across clockRoomItems, items, and community_messages.
     */
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    /**
     * PUBLIC READ ACCESS
     * Required for branding assets and system config before login.
     */
    match /system/config {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }
  }
}
