
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is a Super Admin
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" || 
        request.auth.token.email == "worker@gmail.com"
      );
    }

    // Universal Rule: Any signed-in user can read anything.
    // Super Admins can write anything.
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Specific permissions for Students
    match /users/{userId} {
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /items/{itemId} {
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
    }
  }
}
