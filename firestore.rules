
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * LOSTIFY SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset enforces a strict identity-based access model.
     * Deployment triggered to fix chat list permissions.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isParticipant(participants) {
      return isSignedIn() && (request.auth.uid in participants);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the User collection.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    /**
     * @description Look-up collection for administrative privileges.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false; 
    }

    /**
     * @description Items (Lost/Found).
     */
    match /items/{itemId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    /**
     * @description Private chats.
     * Rule updated to match query filters for participants.
     */
    match /chats/{chatId} {
      allow get, list: if isParticipant(resource.data.participantIds) || isAdmin();
      allow create: if isSignedIn();
      allow update: if isParticipant(resource.data.participantIds);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin());
        allow create: if isSignedIn();
        allow update, delete: if resource != null && resource.data.senderId == request.auth.uid;
      }
    }

    /**
     * @description Public auction listings.
     */
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if (resource != null && resource.data.bidderId == request.auth.uid) || isAdmin();
      }
    }

    /**
     * @description Audit logs.
     */
    match /adminActivityLogs/{logId} {
      allow get, list, create: if isAdmin();
      allow update, delete: if false;
    }

    /**
     * @description Application Settings.
     */
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
