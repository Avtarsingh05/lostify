rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Absolute Admin check for the user's UIDs and Email
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" ||
        request.auth.token.email == "worker@gmail.com"
      );
    }

    // Universal read/write access for Super Admins
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Items: Anyone signed in can read/create. Owners/Admins can update.
    match /items/{itemId} {
      allow read, create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || resource.data.ownerId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Banners: Read for everyone, Write for Admins
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ShopItems: Read for everyone, Write for Admins
    match /shopItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Notifications: Read for targeted user or all, Write for Admins
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow write: if isSuperAdmin();
    }

    // Users: Read for everyone, Write for owner or Admin
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
    }

    // Orders: Owners can see their own orders. Admins see all.
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
    }

    // Auctions: Read for everyone, Write for Admins
    match /auctions/{auctionId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}