
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Lostify Branding Rules
     * Allows public access to system config for login page branding.
     */
    match /system/config {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /**
     * Broadcast & Banner Rules
     * Allows all authenticated students to see announcements.
     */
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /banners/{bannerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /shopItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    /**
     * Core Application Rules
     * Default fallback for all other collections.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
