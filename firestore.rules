
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * LOSTIFY GLOBAL SECURITY RULES - COMPREHENSIVE OVERHAUL
     * PROJECT ID: studio-8346545449-2bbf4
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // SUPER ADMIN - Explicitly whitelist your account
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" || 
        request.auth.token.email == "worker@gmail.com"
      );
    }

    // Check for Guard role or higher
    function isGuard() {
      return isSuperAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "GUARD");
    }

    // Check for Admin role or higher
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN" || isSuperAdmin()));
    }

    // GLOBAL OVERRIDE: Super Admin allows everything
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isGuard();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Items Rules
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isGuard() || isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Notifications Rules
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    // Auction Rules
    match /auctions/{auctionId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow write: if isAdmin() || (isSignedIn() && resource.data.bidderId == request.auth.uid);
      }
    }

    // Activity Logs
    match /adminActivityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
