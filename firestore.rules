
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE HELPERS
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * MASTER AUTHORITY BYPASS
     * Direct root access for super administrators.
     */
    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" ||
        request.auth.uid == "9Qv4QkTuukaYhr2sggnQmQmqgHu1" ||
        (request.auth.token.keys().contains('email') && (
          request.auth.token.email == "worker@gmail.com" ||
          request.auth.token.email == "forigloohelp@gmail.com" ||
          request.auth.token.email == "avtarsingh9528972330@gmail.com"
        ))
      );
    }

    /**
     * GLOBAL BYPASS
     */
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isMasterAdmin());
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    match /shopItems/{itemId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isMasterAdmin();
    }

    /**
     * CLOCK ROOM & HANDOVERS
     * Simplified rules to ensure no blocking errors.
     */
    match /clockRoomItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    match /clockRoomHandovers/{handoverId} {
      allow read, write: if isSignedIn();
    }

    match /handovers/{handoverId} {
      allow read, write: if isSignedIn();
    }

    match /system/config {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}
