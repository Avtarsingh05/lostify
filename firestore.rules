rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GLOBAL AUTHENTICATED ACCESS
     * Explicitly permits all authenticated users to perform any operation 
     * on all collections. This is the most robust way to ensure no 
     * "Missing or insufficient permissions" errors occur for signed-in users.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /**
     * PUBLIC READ ACCESS
     * Essential branding and promotional data must be available to everyone.
     */
    match /system/config {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
    }
    
    match /items/{itemId} {
      allow read: if true;
    }
  }
}