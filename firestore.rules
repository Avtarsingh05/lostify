rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * LOSTIFY GLOBAL SECURITY RULES - REWRITTEN FOR PROJECT: studio-8346545449-2bbf4
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Comprehensive Admin check - Explicitly whitelists YOUR account
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" || 
        request.auth.token.email == "worker@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN")
      );
    }

    // Guard check (includes Admins)
    function isGuard() {
      return isAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "GUARD");
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isGuard();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Items Rules
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isGuard() || isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Notifications Rules
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || resource.data.senderId == request.auth.uid;
      }
    }

    // Auction Rules
    match /auctions/{auctionId} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow write: if isAdmin() || (isSignedIn() && resource.data.bidderId == request.auth.uid);
      }
    }

    // Activity Logs
    match /adminActivityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
