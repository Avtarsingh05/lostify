
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "9Qv4QkTuukaYhr2sggnQmQmqgHu1" ||
        request.auth.token.email == "worker@gmail.com" ||
        request.auth.token.email == "forigloohelp@gmail.com" ||
        request.auth.token.email == "avtarsingh9528972330@gmail.com"
      );
    }

    function getRole() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDoc) ? get(userDoc).data.role : "USER";
    }

    function isStaff() {
      return isMasterAdmin() || (isSignedIn() && (getRole() == "ADMIN" || getRole() == "GUARD"));
    }

    // --- GLOBAL BYPASS FOR MASTER ADMINS ---
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if request.auth.uid == userId;
    }

    match /handovers/{handoverId} {
      allow read: if isSignedIn() && (isStaff() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
    }

    match /clockRoomItems/{itemId} {
      allow read: if isSignedIn() && (isStaff() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isStaff() || resource.data.userId == request.auth.uid);
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaff();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /shopItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (isStaff() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isStaff();
    }

    match /system/config {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
