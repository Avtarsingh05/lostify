
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      // Safely fetch the role from the users collection
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        // 1. Hardcoded UIDs for Master Authority
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "9Qv4QkTuukaYhr2sggnQmQmqgHu1" ||
        // 2. Official Administrator Emails
        request.auth.token.email == "worker@gmail.com" ||
        request.auth.token.email == "forigloohelp@gmail.com" ||
        request.auth.token.email == "avtarsingh9528972330@gmail.com" ||
        // 3. Dynamic Role Check (Set via Admin Console)
        getRole() == "ADMIN"
      );
    }

    function isGuard() {
      return isSignedIn() && (isSuperAdmin() || getRole() == "GUARD");
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isOwner(userId);
    }

    match /clockRoomItems/{itemId} {
      // Allow guards and admins to see all items, owners see their own
      // prioritize role checks to allow collection-wide 'list' operations
      allow read: if isSignedIn() && (isGuard() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isGuard() || resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isGuard());
      allow delete: if isSuperAdmin();
    }

    match /handovers/{handoverId} {
      // Secure Handover access: Admins/Guards can audit everything
      allow read: if isSignedIn() && (isGuard() || resource.data.userId == request.auth.uid || resource.data.guardId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /system/config {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
    
    match /shopItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
