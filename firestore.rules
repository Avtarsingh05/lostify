rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Absolute Admin check for the user's UIDs and Email
    // This allows you to bypass all restrictions in the Admin and Guard panels
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == "PX8zNjMWBWTFGYnaYWrtxojquD02" || 
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" ||
        request.auth.token.email == "worker@gmail.com"
      );
    }

    // Universal read/write access for Super Admins across all collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Universal read access for all signed-in students
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /banners/{bannerId} {
      allow read: if isSignedIn();
    }

    match /shopItems/{itemId} {
      allow read: if isSignedIn();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
    }

    // Orders specific rules
    match /orders/{orderId} {
      // Explicitly allow get and list for owners and admins
      allow get, list: if isSignedIn() && (isSuperAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow create: if isSignedIn();
    }

    match /auctions/{auctionId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}