
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for better rule management
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admins/$(request.auth.uid)) || 
             request.auth.token.email.matches('.*avtarsingh.*@gmail.com') ||
             request.auth.token.email.matches('.*worker.*@gmail.com') ||
             request.auth.token.email.matches('.*forigloohelp@gmail.com');
    }

    function isGuard() {
      return exists(/databases/$(database)/documents/roles_guards/$(request.auth.uid)) || isAdmin();
    }

    /**
     * CLOCK ROOM SECURITY
     * Allows all authenticated users to read/list to prevent query failures,
     * while the UI handles personal data filtering.
     */
    match /clockRoomItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    /**
     * GLOBAL AUTHENTICATED ACCESS (Fallback)
     */
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    /**
     * PUBLIC READ ACCESS
     */
    match /system/config {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }
  }
}
