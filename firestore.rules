
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * LOSTIFY GLOBAL SECURITY RULES - REWRITTEN FOR FULL FUNCTIONALITY
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Comprehensive Admin check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "tkGcuQnwxGgC32WZrtinZifDrDI2" || 
        request.auth.token.email == "worker@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN")
      );
    }

    // Guard check (includes Admins)
    function isGuard() {
      return isAdmin() || (isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "GUARD");
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || isGuard();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Items Rules
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isGuard() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Notifications Rules (Public Read, Admin Write)
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn(); // Messages are filtered by chat access
        allow create: if isSignedIn();
        allow update, delete: if resource.data.senderId == request.auth.uid || isAdmin();
      }
    }

    // Auction Rules
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (resource != null && resource.data.sellerId == request.auth.uid);

      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin() || (resource != null && resource.data.bidderId == request.auth.uid);
      }
    }

    // Activity Logs
    match /adminActivityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
