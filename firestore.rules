
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for better rule management
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admins/$(request.auth.uid)) || 
             request.auth.token.email.matches('.*avtarsingh.*@gmail.com') ||
             request.auth.token.email.matches('.*worker.*@gmail.com') ||
             request.auth.token.email.matches('.*forigloohelp@gmail.com');
    }

    function isGuard() {
      return exists(/databases/$(database)/documents/roles_guards/$(request.auth.uid)) || isAdmin();
    }

    /**
     * CLOCK ROOM SECURITY
     * Explicitly allow all authenticated users to read and list.
     * The UI logic handles personal data filtering to prevent users seeing others' items.
     */
    match /clockRoomItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    /**
     * COMMUNITY MESSAGES
     * Allow reading and creating messages for authenticated users.
     */
    match /community_messages/{messageId} {
      allow read, create: if isSignedIn();
      allow delete, update: if isAdmin();
    }

    /**
     * GLOBAL AUTHENTICATED ACCESS (Fallback)
     * Provides a catch-all for signed-in users while explicit matches above handle listing nuances.
     */
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    /**
     * PUBLIC READ ACCESS
     */
    match /system/config {
      allow read: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
    }
  }
}
